/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Optional compatibility overrides for matching external (e.g., Theiagen) refs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Usage example:
    nextflow run main.nf -profile docker,theiagen_compat \
      --input samplesheet.csv --input_gff samplesheet_gff.csv --outdir results

    Set any of these env vars before running to override default references.
----------------------------------------------------------------------------------------
*/

params {
    kraken2_db          = System.getenv('THEIAGEN_KRAKEN2_DB')          ?: params.kraken2_db
    zipped_sketch       = System.getenv('THEIAGEN_MASH_SKETCH')         ?: params.zipped_sketch
    custom_mlstdb       = System.getenv('THEIAGEN_MLST_DB')             ?: params.custom_mlstdb
    nodes               = System.getenv('THEIAGEN_TAX_NODES')           ?: params.nodes
    names               = System.getenv('THEIAGEN_TAX_NAMES')           ?: params.names
    hvgamdb             = System.getenv('THEIAGEN_HV_DB')               ?: params.hvgamdb
    ardb                = System.getenv('THEIAGEN_AR_DB')               ?: params.ardb
    gamdbpf             = System.getenv('THEIAGEN_PLASMID_DB')          ?: params.gamdbpf
    amrfinder_db        = System.getenv('THEIAGEN_AMRFINDER_DB')        ?: params.amrfinder_db
    ncbi_assembly_stats = System.getenv('THEIAGEN_ASSEMBLY_STATS')      ?: params.ncbi_assembly_stats
    reference_outdir    = System.getenv('THEIAGEN_OUTBREAK_REF_OUTDIR') ?: params.reference_outdir
    ref_samples         = System.getenv('THEIAGEN_REF_SAMPLES')         ?: params.ref_samples
    id_db               = System.getenv('THEIAGEN_ID_DB')               ?: params.id_db
}
